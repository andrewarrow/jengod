{
  "manifest_version": 3,
  "name": "Capital Safari",
  "version": "1.0.0",
  "description": "Convert every visible letter on a webpage to uppercase.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["<all_urls>"]
}
